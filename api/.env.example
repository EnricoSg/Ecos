# Copie este arquivo para api/.env e preencha os valores. O .env nunca é commitado.

# Porta da API
PORT=3000

# Origem autorizada pelo CORS (Dashboard RH em Vite)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (mesmos nomes usados pelos scripts em ai/)
ECOS_DB_HOST=localhost
ECOS_DB_PORT=5432
ECOS_DB_NAME=ecos_teste
ECOS_DB_USER=postgres
ECOS_DB_PASSWORD=

# Chave do coletor oficial, enviada no cabeçalho X-API-Key do POST /api/telemetria.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Login do RH (provisório, até existir uma tabela de usuários do RH)
RH_USUARIO=rh
RH_SENHA=

# Segredo para assinar os tokens JWT (mínimo de 32 caracteres; gere como a API_KEY)
JWT_SECRET=
JWT_EXPIRA_EM=8h

# Opcionais: tamanho máximo do lote e limites de requisições por IP (janelas em minutos)
# LOTE_MAXIMO=1000
# LIMITE_LOGIN=10
# LIMITE_LOGIN_JANELA_MIN=15
# LIMITE_TELEMETRIA=120
# LIMITE_TELEMETRIA_JANELA_MIN=1
# LIMITE_LEITURA=300
# LIMITE_LEITURA_JANELA_MIN=15
