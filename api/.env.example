# Copie este arquivo para api/.env e preencha os valores. O .env nunca é commitado.

# Porta da API
PORT=3000

# Origem autorizada pelo CORS (Dashboard RH em Vite)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (mesmos nomes usados pelos scripts em ai/)
ECOS_DB_HOST=localhost
ECOS_DB_PORT=5432
ECOS_DB_NAME=ecos_teste
ECOS_DB_USER=postgres
ECOS_DB_PASSWORD=

# Chave do coletor oficial, enviada no cabeçalho X-API-Key do POST /api/telemetria.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Login do RH (provisório, até existir uma tabela de usuários do RH)
RH_USUARIO=rh
RH_SENHA=

# Segredo para assinar os tokens JWT (mínimo de 32 caracteres; gere como a API_KEY)
JWT_SECRET=
JWT_EXPIRA_EM=8h

# Opcionais: tamanho máximo do lote e limites de requisições por IP (janelas em minutos)
# LOTE_MAXIMO=1000
# LIMITE_LOGIN=10
# LIMITE_LOGIN_JANELA_MIN=15
# LIMITE_TELEMETRIA=120
# LIMITE_TELEMETRIA_JANELA_MIN=1
# LIMITE_LEITURA=300
# LIMITE_LEITURA_JANELA_MIN=15

# Ambiente. Com NODE_ENV=production a API se recusa a subir se faltar API_KEY, JWT_SECRET (32+ caracteres),
# RH_USUARIO/RH_SENHA ou ECOS_DB_PASSWORD.
NODE_ENV=development

# Quantos proxies reversos ficam na frente da API (ex.: 1). Vazio = acesso direto.
TRUST_PROXY=

# Setores com menos colaboradores ativos que isso não têm dados agregados exibidos (1 = desligado).
# Recomendado: 5. Para a demonstração com poucos colaboradores no seed, deixe 1.
MIN_COLABORADORES_SETOR=1

# Tamanho da janela de análise da IA, em minutos. Deve ser IGUAL ao IA_JANELA_MINUTOS do ai/.env:
# o detalhe do alerta (GET /api/alertas/:id) reconstrói a janela que gerou a anomalia.
# IA_JANELA_MINUTOS=15

# Esconde o Swagger UI (/api-docs) se for false
# DOCS_HABILITADAS=true

# Fuso das sessões do banco. Defina SÓ depois de aplicar a migração 003_datas_fuso.sql.
# ECOS_DB_TIMEZONE=America/Sao_Paulo

# Opcionais do banco: TLS para bancos gerenciados e limites do pool
# ECOS_DB_SSL=true
# ECOS_DB_POOL_MAX=10
# ECOS_DB_CONNECT_TIMEOUT_MS=5000
# ECOS_DB_STATEMENT_TIMEOUT_MS=15000
