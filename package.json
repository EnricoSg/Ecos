{
  "name": "ecos",
  "version": "1.0.0",
  "description": "Ecos - Assinatura Digital Comportamental Corporativa: deteção precoce de fadiga, stress e burnout a partir de metadados de interação.",
  "main": "src/validador.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/iniciar.js",
    "start:simulado": "node scripts/iniciar.js --modo=simulado",
    "start:fadiga": "node scripts/iniciar.js --modo=simulado --perfil=fadiga",
    "demo:dados": "node scripts/python.js ai/gerar_demo.py --confirmar",
    "ia": "node scripts/python.js ai/pipeline.py",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnricoSg/Ecos.git"
  },
  "keywords": [
    "telemetria",
    "lgpd",
    "burnout",
    "saude-ocupacional",
    "esg"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EnricoSg/Ecos/issues"
  },
  "homepage": "https://github.com/EnricoSg/Ecos#readme",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/",
      "/api/",
      "/coletor/"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
