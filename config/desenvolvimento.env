# =====================================================
# ECOS - Configuração padrão de DESENVOLVIMENTO
#
# Valores prontos para rodar o projeto em qualquer máquina sem criar .env.
# Este arquivo é versionado de propósito: nada aqui é segredo de verdade.
#
# Ordem de leitura (o primeiro que definir a variável vence):
#   1. variáveis do sistema (ex.: definidas no provedor de nuvem)
#   2. .env do módulo (api/.env, ai/.env, coletor/.env), se existir
#   3. .env da raiz, se existir: ajustes desta máquina (o "npm run configurar" grava aqui a senha do PostgreSQL)
#   4. este arquivo
#
# Com NODE_ENV=production este arquivo é IGNORADO: em produção todos os valores
# precisam vir do ambiente, e a API se recusa a subir se faltar algum segredo.
# =====================================================

# PostgreSQL local (senha mais comum em instalações de estudo; se a sua for outra, rode "npm run configurar")
ECOS_DB_HOST=localhost
ECOS_DB_PORT=5432
ECOS_DB_NAME=ecos_db
ECOS_DB_USER=postgres
ECOS_DB_PASSWORD=postgres

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Chave do coletor (cabeçalho X-API-Key): a API e o coletor leem o mesmo valor daqui
API_KEY=ecos-chave-local-de-desenvolvimento

# Login do Dashboard RH
RH_USUARIO=rh
RH_SENHA=ecos123

# Segredo dos tokens JWT (mínimo de 32 caracteres)
JWT_SECRET=ecos-segredo-jwt-local-de-desenvolvimento-2026
JWT_EXPIRA_EM=8h

# Privacidade: setores com menos colaboradores ativos que isso não têm tendência exibida
MIN_COLABORADORES_SETOR=5

# Coletor
API_URL=http://localhost:3000/api/telemetria
# Colaborador desta máquina (colaborador 1 do seed, setor Tecnologia da Informação)
USER_ID=a2a0159acf6ac55f05c0c4d4bdc54004
# Colaborador do SIMULADOR (criado pelo "npm run demo:dados"), para não misturar simulação com digitação real
USER_ID_SIMULADO=841b51209530c44244ea70d06a3ddd65
