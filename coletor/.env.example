# OPCIONAL: só crie coletor/.env se precisar mudar algo NESTE módulo. Sem ele, valem os padrões de config/desenvolvimento.env
# (para ajustes da máquina inteira, prefira o .env da raiz). Lista de referência das variáveis; o .env nunca é commitado.

# Endpoint de entrada da API do Ecos
API_URL=http://localhost:3000/api/telemetria

# Chave do coletor oficial: o MESMO valor de API_KEY em api/.env
API_KEY=

# Hash anônimo do colaborador desta máquina (colaborador 1 do seed de testes)
USER_ID=a2a0159acf6ac55f05c0c4d4bdc54004

# Colaborador usado pelo SIMULADOR (MODO=simulado). Evita misturar dados simulados com a digitação
# real do USER_ID no mesmo baseline da IA. O ai/gerar_demo.py cria esse colaborador e mostra o hash.
# Vazio = o simulador usa o USER_ID (comportamento antigo).
USER_ID_SIMULADO=

# Fonte dos eventos: simulado (padrão) ou real (captura do teclado e mouse via uiohook-napi)
MODO=simulado

# Perfil do simulador (só vale com MODO=simulado): normal ou fadiga
PERFIL=normal

# Envio em lote: dispara ao juntar TAMANHO_LOTE eventos ou a cada INTERVALO_ENVIO_MS, o que vier primeiro
TAMANHO_LOTE=20
INTERVALO_ENVIO_MS=5000

# Opcionais: máximo de eventos guardados sem conexão e tempo limite de cada requisição
# FILA_MAXIMA=5000
# TIMEOUT_MS=10000
