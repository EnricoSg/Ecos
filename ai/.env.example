# Copie este arquivo para ai/.env e preencha os valores. O .env nunca é commitado.

# PostgreSQL (mesmos nomes usados pela API em api/.env)
ECOS_DB_HOST=localhost
ECOS_DB_PORT=5432
ECOS_DB_NAME=ecos_db
ECOS_DB_USER=postgres
ECOS_DB_PASSWORD=

# Parâmetros do motor de anomalias (todos opcionais; os valores abaixo são os padrões)
# Tamanho de cada janela de análise, em minutos
# IA_JANELA_MINUTOS=15
# Janelas com menos eventos que isso não são avaliadas (amostra pequena demais)
# IA_MIN_EVENTOS_JANELA=30
# Eventos de histórico necessários antes de começar a avaliar um colaborador (calibração)
# IA_MIN_HISTORICO=200
# Período de histórico usado para a dispersão e para o baseline, em dias
# IA_REFERENCIA_DIAS=30
# Idade máxima do baseline antes de ser recalculado, em dias
# IA_BASELINE_VALIDADE_DIAS=7
# Pontuação mínima de cada nível (MEDIO e ALTO geram alerta para o RH)
# IA_LIMIAR_BAIXO=1.25
# IA_LIMIAR_MEDIO=1.75
# IA_LIMIAR_ALTO=2.5
# Máximo de eventos lidos por execução
# IA_LIMITE_EVENTOS=100000
# Fuso horário usado nas mensagens dos alertas
# IA_FUSO_HORARIO=America/Sao_Paulo
